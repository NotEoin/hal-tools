#!/usr/bin/env bash
# Runs the Telegram bridge with a Python that can read voice notes: HAL_TELEGRAM_PYTHON,
# hal-voice's virtualenv beside this checkout, or python3 (text only), in that order.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
for py in "${HAL_TELEGRAM_PYTHON:-}" "$HERE/../hal-voice/.venv/bin/python" "$(command -v python3)"; do
  if [ -n "$py" ] && [ -x "$py" ]; then
    cd "$HERE" && exec "$py" -m haltelegram "$@"
  fi
done
echo "no Python found" >&2
exit 1
