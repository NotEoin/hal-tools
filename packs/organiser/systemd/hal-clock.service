[Unit]
Description=Hal clock: fires timers, alarms and Pomodoro changes
PartOf=hal.target
After=graphical-session.target

[Service]
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/python3 -m halclock.daemon
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=hal.target
