[Unit]
Description=Hal %i briefing: spoken, pushed and saved to the daily note
After=hal-tts.service

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# When the voice server is starting (it takes about a minute after login), wait for it.
ExecStartPre=-/bin/sh -c 'systemctl --user -q is-active hal-tts.service || exit 0; for i in $$(seq 1 90); do curl -s -o /dev/null -m 2 http://127.0.0.1:9880/ && exit 0; sleep 2; done'
ExecStart=/usr/bin/python3 -m halbrief brief kind=%i
