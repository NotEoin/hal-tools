[Unit]
Description=Hal tasks: due-task reminders and the morning list
After=graphical-session.target

[Service]
WorkingDirectory=%h/src/hal-ecosystem/hal-tasks
ExecStart=/usr/bin/python3 -m haltasks.reminders
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=15

[Install]
WantedBy=graphical-session.target
