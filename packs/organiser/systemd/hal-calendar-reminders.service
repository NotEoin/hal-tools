[Unit]
Description=Hal calendar: event reminders by push, desktop and voice, and CalDAV sync
PartOf=hal.target
After=network-online.target graphical-session.target

[Service]
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/python3 -m halcal.reminders
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=15

[Install]
WantedBy=hal.target
